# Copy to .env locally; never commit real secrets.
# Relay server
PORT=3000
BRIDGE_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_ID=replace-with-your-bot-id
TELEGRAM_ALLOWED_USER_ID=replace-with-your-user-id
# Local connector: must match server BRIDGE_SECRET
FRIDAY_MINIAPP_BRIDGE_SECRET=replace-with-a-long-random-secret
FRIDAY_MINIAPP_URL=https://your-app.nibrun.app
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Optional: otherwise connector reads your local OpenClaw configuration.
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_CONFIG_PATH=
