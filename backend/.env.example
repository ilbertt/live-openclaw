# Relay
PORT=3000
BRIDGE_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_ID=replace-with-your-bot-id
TELEGRAM_ALLOWED_USER_ID=replace-with-your-user-id
OPENCLAW_SESSION_KEY=agent:your-agent:main:thread:your-user-id:your-thread-id
VOICE_MODEL=gpt-live-1-codex
# Connector (separate local process; secret must match relay)
FRIDAY_MINIAPP_BRIDGE_SECRET=replace-with-a-long-random-secret
FRIDAY_MINIAPP_URL=https://your-app.example.com
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Optional: otherwise read the local OpenClaw configuration and CLI.
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_CONFIG_PATH=
