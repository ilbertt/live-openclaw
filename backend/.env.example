# Relay: configure these on the public host when running the compiled binary.
# Port defaults to NIBRUN_HTTP_PORT, then 3000, when PORT is unset.
PORT=3000
# Generate an independent, high-entropy secret; match it in the connector below.
BRIDGE_SECRET=replace-with-a-long-random-secret
# Numeric bot ID (the part before ':' in its token), not the bot token.
TELEGRAM_BOT_ID=replace-with-your-bot-id
# Numeric Telegram user ID allowed to open voice sessions.
TELEGRAM_ALLOWED_USER_ID=replace-with-your-user-id
# Your existing OpenClaw agent/session route.
OPENCLAW_SESSION_KEY=agent:your-agent:main:thread:your-user-id:your-thread-id
# Voice model defaults to gpt-live-1-codex when unset.
VOICE_MODEL=gpt-live-1-codex

# Connector: configure these on the machine running your OpenClaw Gateway.
# Must equal the relay's BRIDGE_SECRET.
FRIDAY_MINIAPP_BRIDGE_SECRET=replace-with-a-long-random-secret
# Public HTTPS URL of the relay.
FRIDAY_MINIAPP_URL=https://your-app.example.com
# Local Gateway WebSocket URL; this is the default when unset.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Optional explicit Gateway token. Otherwise use local configuration or the CLI.
# OPENCLAW_GATEWAY_TOKEN=
# Optional config path; defaults to ~/.openclaw/openclaw.json.
# OPENCLAW_CONFIG_PATH=
